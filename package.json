{
  "name": "openvts-app-studio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev -p 8082",
    "dev:all": "next dev -p 8082 & tsx worker/build-worker.ts",
    "build": "prisma generate && next build && node scripts/build-sites-preview.mjs",
    "start": "next start -p 8082",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit --pretty false",
    "test": "node --import=tsx --test tests/**/*.test.ts",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "setup": "node scripts/setup-template.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "worker": "tsx worker/build-worker.ts",
    "worker:once": "tsx worker/build-worker.ts --once"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1085.0",
    "@aws-sdk/s3-request-presigner": "3.1085.0",
    "@auth/prisma-adapter": "2.11.2",
    "@prisma/adapter-pg": "7.8.0",
    "@prisma/client": "7.8.0",
    "clsx": "2.1.1",
    "dotenv": "17.2.3",
    "file-type": "22.0.1",
    "jszip": "3.10.1",
    "lucide-react": "0.562.0",
    "next": "16.2.10",
    "next-auth": "5.0.0-beta.31",
    "pg": "8.16.3",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sharp": "0.35.3",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.2",
    "@types/node": "24.10.1",
    "@types/pg": "8.15.6",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.2",
    "eslint-config-next": "16.2.10",
    "prisma": "7.8.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.22.4",
    "typescript": "5.9.3"
  }
}
