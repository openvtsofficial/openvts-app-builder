# Application
NEXT_PUBLIC_APP_NAME="OpenVTS App Studio"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_DEMO_MODE="true"
NODE_ENV="development"

# Authentication — create credentials in Google Cloud Console.
# Callback URL: http://localhost:3000/api/auth/callback/google
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# PostgreSQL / Prisma
DATABASE_URL="postgresql://openvts:openvts@localhost:5432/openvts_app_studio?schema=public"

# Local storage (development) or S3-compatible object storage (production)
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./data"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="openvts-app-studio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# 32-byte key encoded as 64 hexadecimal characters. Used to encrypt signing
# passwords at rest; never commit a production value.
SIGNING_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Flutter worker
FLUTTER_TEMPLATE_ROOT="./templates/flutter_base"
BUILD_WORKSPACE_ROOT="./data/workspaces"
BUILD_ARTIFACT_ROOT="./data/artifacts"
BUILD_POLL_INTERVAL_MS="2000"
BUILD_TIMEOUT_MS="1200000"
BUILD_CONCURRENCY="1"
FLUTTER_BIN="flutter"

# Demo mode never executes Flutter. It provides working project editing,
# Icon Kitchen validation, source export, and simulated build progress.
DEMO_BUILD_DURATION_MS="12000"
