# Application
NEXT_PUBLIC_APP_NAME="OpenVTS App Studio"
NEXT_PUBLIC_APP_URL="http://localhost:8082"
NEXT_PUBLIC_DEMO_MODE="true"
NODE_ENV="development"

# Authentication — create credentials in Google Cloud Console.
# Callback URL: http://localhost:8082/api/auth/callback/google
AUTH_SECRET="replace-with-a-random-32-byte-secret"
AUTH_GOOGLE_ID="replace-with-google-client-id"
AUTH_GOOGLE_SECRET="replace-with-google-client-secret"

# PostgreSQL / Prisma
DATABASE_URL="postgresql://openvts:openvts@localhost:5432/openvts_app_studio?schema=public"

# Local storage (development) or S3-compatible object storage (production)
STORAGE_DRIVER="local"
LOCAL_STORAGE_ROOT="./data"
S3_ENDPOINT=""
S3_REGION="us-east-1"
S3_BUCKET="openvts-app-studio"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_FORCE_PATH_STYLE="true"

# 32-byte key encoded as 64 hexadecimal characters. Used to encrypt signing
# passwords at rest; never commit a production value.
SIGNING_ENCRYPTION_KEY="replace-with-64-hex-characters"

# Flutter worker
BUILD_WORKSPACE_ROOT="./data/workspaces"
BUILD_ARTIFACT_ROOT="./data/artifacts"
BUILD_POLL_INTERVAL_MS="2000"
BUILD_TIMEOUT_MS="3600000"
# Linux shared hosts: wait before native builds and stop before global OOM.
# Zero disables these guards on a dedicated/local development machine.
BUILD_MIN_HOST_AVAILABLE_MB="0"
BUILD_CRITICAL_HOST_AVAILABLE_MB="0"
FLUTTER_BIN="flutter"

# Demo mode never executes Flutter. It provides working project editing,
# Icon Kitchen validation, source export, and simulated build progress.
DEMO_BUILD_DURATION_MS="12000"

# Logging — set LOGGER_ENABLED=true and choose level: debug | info | warn | error
# In production use "info" or "error" to reduce noise.
LOGGER_ENABLED="true"
LOGGER_LEVEL="info"

# new
FLUTTER_TEMPLATE_REPOSITORY=https://github.com/openvtsofficial/openvts-application.git
FLUTTER_TEMPLATE_BRANCH=main
GIT_BIN=git
GIT_CLONE_TIMEOUT_MS=120000
SIGNING_KEYSTORE_PATH=./signing/application-key.jks
SIGNING_KEY_ALIAS=replace-with-existing-key-alias
SIGNING_STORE_PASSWORD=replace-with-existing-store-password
SIGNING_KEY_PASSWORD=replace-with-existing-key-password
GRADLE_JVM_ARGS="-Xmx1024m -XX:MaxMetaspaceSize=384m -XX:ReservedCodeCacheSize=128m -XX:+HeapDumpOnOutOfMemoryError"
